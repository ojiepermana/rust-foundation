{
  "name": "foundation-rust",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepare": "bun --no-env-file scripts/install-hooks.ts",
    "dev": "bun --no-env-file scripts/dev.ts",
    "build": "bun run build:api && bun run build:web",
    "build:api": "cargo build --locked -p api",
    "build:web": "bun run --filter web build",
    "run:api": "bun --no-env-file scripts/run-api.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:generated",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "lint": "eslint . --max-warnings 0 && cargo clippy --locked --workspace --all-targets -- -D warnings",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json && bun run --filter web typecheck",
    "check:generated": "bun --no-env-file scripts/check-generated.ts",
    "test": "bun run test:scripts && bun run test:web && bun run test:api",
    "test:scripts": "bun test --no-env-file",
    "test:web": "bun run --filter web test",
    "test:api": "cargo test --locked --workspace",
    "test:integration": "bun test --no-env-file ./tests/integration",
    "db:up": "bun --no-env-file scripts/db.ts up",
    "db:down": "bun --no-env-file scripts/db.ts down",
    "db:status": "bun --no-env-file scripts/db.ts status",
    "db:reset": "bun --no-env-file scripts/db.ts reset"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
